# ─── Stellar Network ──────────────────────────────────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Soroban Contracts ────────────────────────────────────────────────────────
# Set to "false" to use real Soroban contracts (after running scripts/deploy-contracts.sh)
NEXT_PUBLIC_SOROBAN_MOCK_MODE=true

# Contract addresses — paste after deployment
NEXT_PUBLIC_BILLER_REGISTRY_CONTRACT=
NEXT_PUBLIC_VOUCHER_CONTRACT=

# USDC token contract on Stellar testnet (Circle's official)
NEXT_PUBLIC_USDC_TOKEN=CB64D3G7SM22THDRK5PT25IEDMTKNTY6HNO3VQGQUZRBVJNHQRUW5KIY

# ─── Optional ─────────────────────────────────────────────────────────────────
# Pre-funded USDC distributor for real airdrops
DEMO_DISTRIBUTOR_SECRET=
